{
  "fqn": "tripguard.control_panel",
  "alias": "tripguard_control_panel",
  "name": "TripGuard Control Panel",
  "description": "Bảng nút điều khiển TripGuard qua ThingsBoard RPC, tối ưu cho web và mobile.",
  "tags": [
    "tripguard",
    "rpc",
    "control",
    "stm32"
  ],
  "deprecated": false,
  "descriptor": {
    "type": "rpc",
    "sizeX": 24,
    "sizeY": 10,
    "resources": [],
    "templateHtml": "\n<div class=\"tripguard-control\">\n  <div class=\"control-head\">\n    <div><div class=\"control-title\">🎛️ ĐIỀU KHIỂN TRIPGUARD</div><div class=\"control-sub\">Dùng được trên web và ThingsBoard Mobile</div></div>\n    <div class=\"control-status\" [ngClass]=\"statusClass\">{{status}}</div>\n  </div>\n  <div class=\"control-grid\">\n    <button class=\"tg-btn blue\" [disabled]=\"busy\" (click)=\"sendTripGuardCommand('playAlarm', '2', '')\">🔊 Phát cảnh báo SOS</button>\n    <button class=\"tg-btn dark\" [disabled]=\"busy\" (click)=\"sendTripGuardCommand('stopAudio', '{}', '')\">⏹ Dừng loa</button>\n    <button class=\"tg-btn green\" [disabled]=\"busy\" (click)=\"sendTripGuardCommand('setRadarAlerts', 'true', '')\">📡 Bật cảnh báo radar</button>\n    <button class=\"tg-btn gray\" [disabled]=\"busy\" (click)=\"sendTripGuardCommand('setRadarAlerts', 'false', '')\">📡 Tắt cảnh báo radar</button>\n    <button class=\"tg-btn orange\" [disabled]=\"busy\" (click)=\"sendTripGuardCommand('acknowledgeSOS', '{}', '')\">✅ Xác nhận / dừng cảnh báo</button>\n    <button class=\"tg-btn violet\" [disabled]=\"busy\" (click)=\"sendTripGuardCommand('refreshTelemetry', '{}', '')\">🔄 Cập nhật telemetry ngay</button>\n    <button class=\"tg-btn warn\" [disabled]=\"busy\" (click)=\"sendTripGuardCommand('sendRadarSms', '{}', 'Gửi SMS cảnh báo radar đến số khẩn cấp?')\">✉️ Gửi thử SMS radar</button>\n    <button class=\"tg-btn danger\" [disabled]=\"busy\" (click)=\"sendTripGuardCommand('triggerSOS', '{}', 'NGUY HIỂM: lệnh này sẽ phát loa, gửi SMS và gọi số khẩn cấp. Tiếp tục?')\">🆘 KÍCH HOẠT SOS TỪ XA</button>\n    <button class=\"tg-btn blue\" [disabled]=\"busy\" (click)=\"sendTripGuardCommand('cameraToRadar', '{}', '')\">📷 Camera về radar</button>\n    <button class=\"tg-btn green\" [disabled]=\"busy\" (click)=\"sendTripGuardCommand('cameraHome', '{}', '')\">🏠 Camera về home</button>\n    <button class=\"tg-btn dark\" [disabled]=\"busy\" (click)=\"sendTripGuardCommand('stopServo', '{}', '')\">⏹ Dừng servo</button>\n  </div>\n  <div class=\"period-row\">\n    <span>Chu kỳ gửi:</span>\n    <button [disabled]=\"busy\" (click)=\"sendTripGuardCommand('setTelemetryPeriod', '2000', '')\">2 giây</button>\n    <button [disabled]=\"busy\" (click)=\"sendTripGuardCommand('setTelemetryPeriod', '5000', '')\">5 giây</button>\n    <button [disabled]=\"busy\" (click)=\"sendTripGuardCommand('setTelemetryPeriod', '10000', '')\">10 giây</button>\n  </div>\n  <div class=\"control-note\">Nút SOS vật lý vẫn hoạt động độc lập. Lệnh SMS/SOS có hộp xác nhận để tránh bấm nhầm.</div>\n</div>\n",
    "templateCss": "\n.tripguard-control{height:100%;box-sizing:border-box;padding:16px;background:#fff;border:1px solid #dfe6ee;border-radius:12px;overflow:auto;font-family:Roboto,Arial,sans-serif;color:#172033}\n.control-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:14px}\n.control-title{font-size:19px;font-weight:800}.control-sub{font-size:12px;color:#667085;margin-top:4px}\n.control-status{max-width:48%;padding:7px 11px;border-radius:999px;font-size:12px;font-weight:700;background:#eef2f6;color:#344054;text-align:center}\n.control-status.sending{background:#fff3cd;color:#7a4b00}.control-status.success{background:#dcfce7;color:#166534}.control-status.error{background:#fee2e2;color:#991b1b}\n.control-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}\n.tg-btn{min-height:48px;border:0;border-radius:9px;padding:10px 12px;color:#fff;font-weight:700;font-size:13px;cursor:pointer;box-shadow:0 2px 5px rgba(0,0,0,.14)}\n.tg-btn:disabled,.period-row button:disabled{opacity:.5;cursor:not-allowed}.blue{background:#1976d2}.dark{background:#37474f}.green{background:#2e7d32}.gray{background:#607d8b}.orange{background:#ef6c00}.violet{background:#7b1fa2}.warn{background:#ad6c00}.danger{background:#c62828}\n.period-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:14px;padding-top:12px;border-top:1px solid #e7ebf0;font-size:13px;font-weight:600}\n.period-row button{border:1px solid #b9c4d0;background:#f8fafc;border-radius:7px;padding:7px 12px;cursor:pointer;color:#344054}\n.control-note{margin-top:12px;padding:9px 11px;border-radius:7px;background:#eef6ff;color:#174a7a;font-size:12px}\n@media(max-width:900px){.control-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.control-head{flex-direction:column}.control-status{max-width:100%}}\n@media(max-width:520px){.control-grid{grid-template-columns:1fr}.tripguard-control{padding:12px}.tg-btn{min-height:46px}}\n",
    "controllerScript": "\nself.onInit = function() {\n  var scope = self.ctx.$scope;\n  scope.busy = false;\n  scope.status = 'Sẵn sàng nhận lệnh';\n  scope.statusClass = 'ready';\n\n  function updateStatus(text, cssClass) {\n    scope.status = text;\n    scope.statusClass = cssClass;\n    if (scope.$evalAsync) { scope.$evalAsync(); }\n  }\n\n  scope.sendTripGuardCommand = function(method, params, confirmation) {\n    if (scope.busy) { return; }\n    if (confirmation && !window.confirm(confirmation)) { return; }\n\n    scope.busy = true;\n    updateStatus('Đang gửi: ' + method + ' ...', 'sending');\n\n    var timeout = Number(self.ctx.settings.requestTimeout || 15000);\n    var finished = false;\n    var watchdog;\n\n    function finishOk() {\n      if (finished) { return; }\n      finished = true;\n      window.clearTimeout(watchdog);\n      scope.busy = false;\n      updateStatus('Đã chuyển lệnh: ' + method + '. Xem kết quả lệnh bên dưới.', 'success');\n    }\n\n    function finishError(error) {\n      if (finished) { return; }\n      finished = true;\n      window.clearTimeout(watchdog);\n      scope.busy = false;\n      var code = error && error.status ? ' (' + error.status + ')' : '';\n      updateStatus('Không gửi được ' + method + code, 'error');\n    }\n\n    watchdog = window.setTimeout(function() {\n      finishError({ status: 'timeout' });\n    }, timeout + 1000);\n\n    try {\n      self.ctx.controlApi.sendOneWayCommand(method, params, timeout)\n        .subscribe(finishOk, finishError, finishOk);\n    } catch (error) {\n      finishError(error);\n    }\n  };\n};\n\nself.typeParameters = function() {\n  return {\n    maxDatasources: 0,\n    dataKeysOptional: true,\n    singleEntity: true,\n    previewWidth: '760px',\n    previewHeight: '360px'\n  };\n};\n\nself.onDestroy = function() {};\n",
    "settingsSchema": "{\"schema\":{\"type\":\"object\",\"title\":\"Settings\",\"properties\":{\"requestTimeout\":{\"title\":\"RPC request timeout (ms)\",\"type\":\"number\",\"default\":15000}},\"required\":[]},\"form\":[\"requestTimeout\"]}",
    "settingsForm": [],
    "dataKeySettingsSchema": "{}",
    "dataKeySettingsForm": [],
    "defaultConfig": "{\"datasources\":[],\"targetDeviceAliasIds\":[],\"timewindow\":null,\"showTitle\":false,\"backgroundColor\":\"#ffffff\",\"color\":\"rgba(0,0,0,0.87)\",\"padding\":\"0px\",\"settings\":{\"requestTimeout\":15000},\"title\":\"TripGuard Control Panel\",\"dropShadow\":true,\"enableFullscreen\":true,\"widgetStyle\":{},\"actions\":{}}"
  },
  "resources": []
}
